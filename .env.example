# Copy to .env and fill in.  NEVER commit .env — it is in .gitignore for a reason.
#   cp .env.example .env
#   git check-ignore .env      # must print: .env

# ---- Django ----
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Day 3: your deployment ----
# Your team's subdomain, once you have one.
TEAM_HOST=team07.example.in

# ---- Day 6: presence signals ----
# The campus network range. Ask your instructor for the real value.
CAMPUS_CIDR=10.0.0.0/8
# How long a projector code stays valid, in seconds.
SESSION_CODE_TTL=60

# ---- Day 7: face matching ----
# You choose this on Day 7, from your own threshold sweep. Do not guess.
FACE_THRESHOLD=0.60
FACE_MODEL_DIR=models

# ---- Day 8: the class LLM proxy ----
# Your instructor issues this token. It is rate-limited and capped per team.
LLM_PROXY_URL=http://class-server:8099
LLM_PROXY_TOKEN=
LLM_MODEL=claude-haiku-4-5-20251001

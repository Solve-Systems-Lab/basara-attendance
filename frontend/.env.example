# Copy to .env.local and adjust if your backend is not on the default port.
#
# In development you can leave this empty: vite.config.ts proxies /api to
# http://localhost:8000, so the browser sees a single origin and CORS never
# comes up. Set it only when you are pointing at a deployed backend.
VITE_API_BASE_URL=

# Anything prefixed VITE_ is compiled into the JavaScript bundle and shipped
# to every visitor. It is public. Secrets belong in the backend .env, not here.
